# Copy to .env. Shell assignments; do not paste untrusted commands into this file.
MIMIC_BIND=127.0.0.1
MIMIC_PORT=8765
# For iPhone: replace BOTH with your Mac private Wi-Fi IPv4, e.g. 192.168.1.20.
# MIMIC_BIND=192.168.1.20
# MIMIC_LAN_IP=192.168.1.20
# Optional local AI, no API key:
# MIMIC_EMBED_MODEL=embeddinggemma
# Optional trusted local HTTPS (see README):
# MIMIC_TLS_CERT=/absolute/path/localhost.pem
# MIMIC_TLS_KEY=/absolute/path/localhost-key.pem
